# Studio IA — variables lues par src/lib/studio-ia et src/app/api/{studio-ia,kie,upload,media}.
# Les clés peuvent aussi être saisies dans data/db.json (settings) ; la variable d'environnement gagne.
KIE_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=
# URL publique du site (callbacks KIE) : laisser vide en local, le Studio sonde les tâches à la place.
PUBLIC_BASE_URL=
# URL publique qui sert data/media (les modèles vidéo ne lisent que des URL publiques).
MEDIA_PUBLIC_URL=
# Optionnel : hôte SSH relais pour rapatrier les rendus quand le serveur n'est pas joignable.
MEDIA_FETCH_RELAY_SSH=
