# Nom de domaine de l'outil lui-même (mabillmafia.com, Namecheap). src/proxy.ts le connaît déjà ;
# cette variable sert à en déclarer d'autres (aperçus, anciens domaines), séparés par des virgules.
APP_HOSTS=mabillmafia.com,www.mabillmafia.com

# Studio IA — variables lues par src/lib/studio-ia et src/app/api/{studio-ia,kie,upload,media}.
# Les clés peuvent aussi être saisies dans data/db.json (settings) ; la variable d'environnement gagne.
KIE_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=
# URL publique du site (callbacks KIE) : laisser vide en local, le Studio sonde les tâches à la place.
PUBLIC_BASE_URL=
# URL publique qui sert data/media (les modèles vidéo ne lisent que des URL publiques).
MEDIA_PUBLIC_URL=
# Optionnel : hôte SSH relais pour rapatrier les rendus quand le serveur n'est pas joignable.
MEDIA_FETCH_RELAY_SSH=

# Reign (successeur de Phoenix, https://docs.reign.com) — l'écran Stats lit les deux sources.
# Clé « Read » créée dans le portail Reign (Developers → API Keys). reign_live_… en production, reign_test_… en sandbox.
REIGN_API_KEY=
# Optionnel : nom affiché, boutiques retenues (sto_…, séparées par des virgules), premier jour d'historique.
REIGN_CLIENT_LABEL=
REIGN_STORE_IDS=
REIGN_HISTORY_FROM=2026-01-01
