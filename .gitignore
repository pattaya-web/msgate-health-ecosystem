# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# … sauf le gabarit sans valeurs du Studio IA
!.env.example

# Airtable exports (may contain PII)
/data/airtable-clean/
/data/airtable-raw/

# Phoenix snapshot cache (subscriber + transaction data, PII)
/.phoenix-cache/
/.msgate-cache/
.phoenix-sample.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cours Whop récupérés localement : contenu payant, jamais commité
whop-export/
curl.txt
lesson*.html
*.pdf

# Creas de reference d autrui : restent locales
/data/style-posters/*
!/data/style-posters/README.md

# Videos de reference d autrui
/data/references/*
!/data/references/README.md

# Studio IA : base locale et médias (jamais versionnés)
/data/db.json
/data/db.json.*.tmp
/data/media/
/data/ig-cookies.txt
